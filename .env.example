# REXONOBIT — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is gitignored.

# ─── Stacks Network ──────────────────────────────────────────
# Values: "mainnet" | "testnet" | "devnet"
VITE_STACKS_NETWORK=testnet

# ─── Contract Deployer Address ───────────────────────────────
# The STX address that deployed the contracts (no private key here)
VITE_DEPLOYER_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM

# ─── Contract Names ──────────────────────────────────────────
VITE_CONTRACT_REGISTRY=cooperative-registry
VITE_CONTRACT_SAVINGS_VAULT=savings-vault
VITE_CONTRACT_TRUST_SCORE=trust-score
VITE_CONTRACT_LENDING_POOL=lending-pool
VITE_CONTRACT_LABOR_MARKET=labor-market
VITE_CONTRACT_TREASURY=treasury
VITE_CONTRACT_GOVERNANCE=governance
VITE_CONTRACT_ROSCA=rosca
VITE_CONTRACT_REPUTATION_NFT=reputation-nft
VITE_CONTRACT_ARBITRATION=arbitration
VITE_CONTRACT_SYNTHETIC_CREDIT=synthetic-credit
VITE_CONTRACT_PROTOCOL_CONFIG=protocol-config

# ─── Stacks API ──────────────────────────────────────────────
VITE_STACKS_API_URL=https://api.testnet.hiro.so

# ─── App ─────────────────────────────────────────────────────
VITE_APP_NAME=Rexonobit
VITE_APP_ICON_URL=https://rexonobit.xyz/icon.png
