# frontend/.env.example
# Copy to frontend/.env and fill in values.
# NEVER commit .env — it is gitignored.

# ─── Stacks Network ─────────────────────────────────────────────────────────
# Values: testnet | mainnet | devnet
VITE_STACKS_NETWORK=testnet

# ─── Deployer Address ────────────────────────────────────────────────────────
# The STX address that deployed all 12 REXONOBIT contracts
# Testnet example: ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
VITE_DEPLOYER_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM

# ─── Stacks API Node ─────────────────────────────────────────────────────────
# Override if using a custom/private Stacks API node
# Defaults in code: https://stacks-node-api.testnet.stacks.co
# VITE_STACKS_API_URL=https://stacks-node-api.testnet.stacks.co

# ─── App Identity ────────────────────────────────────────────────────────────
VITE_APP_NAME=REXONOBIT
VITE_APP_ICON_URL=https://rexonobit.io/icon.png

# ─── Optional: Stacks Explorer ──────────────────────────────────────────────
# VITE_EXPLORER_URL=https://explorer.hiro.so
